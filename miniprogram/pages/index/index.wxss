.page { max-width: 900rpx; margin: 0 auto; padding: 24rpx 24rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.card { padding: 32rpx; margin-bottom: 24rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.04); }
.history { background: #e9f2ff; }
.eyebrow { display: block; color: #526581; font-size: 24rpx; }
.history-name { display: block; margin: 12rpx 0 8rpx; font-size: 34rpx; font-weight: 600; word-break: break-all; }
.history-time { display: block; margin-bottom: 12rpx; color: #40536c; font-size: 26rpx; }
.heading { margin-bottom: 36rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; }
.subtitle { display: block; margin-top: 12rpx; color: #667085; font-size: 26rpx; }
.label { display: block; margin-bottom: 14rpx; font-weight: 600; font-size: 28rpx; }
.select { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; padding: 20rpx 24rpx; border: 2rpx solid #dfe4eb; border-radius: 16rpx; font-size: 30rpx; }
.select > text:first-child { min-width: 0; word-break: break-all; }
.arrow { flex-shrink: 0; margin-left: 16rpx; color: #667085; }
.selection { margin-top: 18rpx; font-size: 26rpx; color: #526581; line-height: 1.6; word-break: break-all; }
.selection-name { color: #075dc0; font-weight: 600; }
.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.scan-button, .send-button { flex: 1; margin: 0; border-radius: 16rpx; color: #fff; font-weight: 600; line-height: 1.5; padding: 26rpx 16rpx; }
.scan-button { background: #087af5; }
.scan-button[disabled] { background: #087af5; color: #fff; }
.reconnect-button { margin: 0; border-radius: 16rpx; background: #edf4ff; color: #075dc0; padding: 26rpx 22rpx; font-size: 28rpx; line-height: 1.5; }
.hint { display: block; color: #667085; font-size: 24rpx; line-height: 1.7; }
.purpose { margin: 16rpx 0 32rpx; }
.field { margin-top: 28rpx; }
.channel-box { margin: 24rpx 0; padding: 24rpx; border-radius: 16rpx; background: #f4f8ff; }
.channel-box .hint { margin-bottom: 14rpx; }
.preview { margin: 32rpx 0 24rpx; padding: 24rpx; background: #f5f7fa; border: 2rpx solid #e8ecf2; border-radius: 16rpx; }
.preview-title { display: block; color: #526581; font-size: 24rpx; font-weight: 600; }
.preview-summary { display: block; margin: 12rpx 0; font-size: 30rpx; font-weight: 600; }
.hex { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 28rpx; line-height: 1.9; word-break: break-all; }
.send-button { width: 100%; background: #20aa62; }
.send-button[disabled] { background: #20aa62; color: #fff; }
.status { margin-top: 24rpx; padding: 24rpx; background: #f5f7fa; border-radius: 14rpx; font-size: 26rpx; line-height: 1.8; word-break: break-all; }
.clear-button { margin: 24rpx 0 0; padding: 16rpx; background: #fff2f0; color: #bd3026; font-size: 26rpx; line-height: 1.5; border-radius: 14rpx; }
.details-toggle { display: flex; justify-content: space-between; gap: 16rpx; font-size: 26rpx; color: #526581; }
.details-content { margin-top: 28rpx; }
.diagnostics { display: block; margin: 24rpx 0; padding: 20rpx; white-space: pre-wrap; word-break: break-all; font-family: ui-monospace, Menlo, monospace; background: #f5f7fa; border-radius: 12rpx; color: #526581; font-size: 22rpx; line-height: 1.8; }
.settings-button { margin: 16rpx 0 0; background: #f1f5fb; color: #075dc0; font-size: 26rpx; line-height: 1.6; padding: 18rpx; border-radius: 12rpx; }
